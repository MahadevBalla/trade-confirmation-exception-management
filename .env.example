# Copy this file to .env and adjust as needed. Never commit the real .env.

# --- CouchDB ---
COUCHDB_USER=admin
COUCHDB_PASSWORD=password
COUCHDB_URL=http://localhost:5984

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Service ports (host side) ---
INGESTION_SERVICE_PORT=8081
ENRICHMENT_SERVICE_PORT=8082
VALIDATION_SERVICE_PORT=8083
EXCEPTION_SERVICE_PORT=8084
WORKITEM_SERVICE_PORT=8085
FRONTEND_PORT=3000
KAFKA_UI_PORT=8080
